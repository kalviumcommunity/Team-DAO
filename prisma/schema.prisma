datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// User role enum
enum UserRole {
  STUDENT
  VERIFIER
  ADMIN
  SUPER_ADMIN
}

// Product/Listing condition enum
enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

// Status of the listing
enum ListingStatus {
  ACTIVE
  PENDING_VERIFICATION
  SOLD
  EXCHANGED
  DEACTIVATED
}

// Type of listing
enum ListingType {
  SALE
  EXCHANGE
  DONATION
  RENT
}

// Status of exchange requests
enum ExchangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Status of listing verification
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Status of orders
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  college     String
  role        UserRole @default(STUDENT)
  isSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  listings                 Listing[]          @relation("UserListings")
  wishlistItems            WishlistItem[]
  cartItems                CartItem[]
  sentExchangeRequests     ExchangeRequest[]  @relation("SentExchanges")
  receivedExchangeRequests ExchangeRequest[]  @relation("ReceivedExchanges")
  verifications            Verification[]     @relation("UserVerifications")
  orders                   Order[]            @relation("UserOrders")
  inventoryLogs            InventoryLog[]     @relation("UserInventoryLogs")
  auditLogs                AuditLog[]         @relation("AdminAuditLogs")
}

model Listing {
  id                String        @id @default(uuid())
  title             String
  description       String
  price             Decimal       @db.Decimal(10, 2) // Decimal for precise monetary values
  condition         Condition
  durationUsed      String?       // E.g., "3 months", "1 year"
  category          String
  brand             String?
  images            String[]      @default([])
  stock             Int           @default(1)
  sellerId          String
  seller            User          @relation("UserListings", fields: [sellerId], references: [id], onDelete: Cascade)
  status            ListingStatus @default(ACTIVE)
  listingType       ListingType   @default(SALE)
  exchangeAvailable Boolean       @default(false)
  verified          Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  wishlistItems        WishlistItem[]
  cartItems            CartItem[]
  offeredInExchanges   ExchangeRequest[] @relation("OfferedListing")
  requestedInExchanges ExchangeRequest[] @relation("RequestedListing")
  verifications        Verification[]
  orderItems           OrderItem[]
  inventoryLogs        InventoryLog[]

  // Indexes for query optimization
  @@index([sellerId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Ensure user cannot wishlist same item multiple times
  @@unique([userId, listingId])

  // Indexes for query optimization
  @@index([listingId])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure unique cart entries per user/listing
  @@unique([userId, listingId])

  // Indexes for query optimization
  @@index([listingId])
}

model ExchangeRequest {
  id                 String         @id @default(uuid())
  senderId           String
  sender             User           @relation("SentExchanges", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId         String
  receiver           User           @relation("ReceivedExchanges", fields: [receiverId], references: [id], onDelete: Cascade)
  offeredProductId   String
  offeredProduct     Listing        @relation("OfferedListing", fields: [offeredProductId], references: [id], onDelete: Cascade)
  requestedProductId String
  requestedProduct   Listing        @relation("RequestedListing", fields: [requestedProductId], references: [id], onDelete: Cascade)
  status             ExchangeStatus @default(PENDING)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Indexes for query optimization
  @@index([senderId])
  @@index([receiverId])
  @@index([offeredProductId])
  @@index([requestedProductId])
}

model Verification {
  id         String             @id @default(uuid())
  productId  String
  product    Listing            @relation(fields: [productId], references: [id], onDelete: Cascade)
  verifierId String
  verifier   User               @relation("UserVerifications", fields: [verifierId], references: [id], onDelete: Cascade)
  status     VerificationStatus @default(PENDING)
  remarks    String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  // Indexes for query optimization
  @@index([productId])
  @@index([verifierId])
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation("UserOrders", fields: [userId], references: [id], onDelete: Cascade)
  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([listingId])
}

model InventoryLog {
  id            String   @id @default(uuid())
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  previousStock Int
  newStock      Int
  updatedById   String
  updatedBy     User     @relation("UserInventoryLogs", fields: [updatedById], references: [id], onDelete: Cascade)
  timestamp     DateTime @default(now())

  @@index([listingId])
  @@index([updatedById])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String?
  details    String?
  timestamp  DateTime @default(now())

  @@index([adminId])
}
